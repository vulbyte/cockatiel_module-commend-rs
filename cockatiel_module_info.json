{
  "name": "commend",
  "description": "chat-command commend \u2014 any verified user may commend another user (unlimited); parses !commend <user> <reason>",
  "version": "0.1.0",
  "capabilities": "preprocess",
  "root_file": "./src/main.rs",
  "launch_command": "cargo",
  "command_flags": [
    "run",
    "--release"
  ],
  "autostart": false,
  "terminal": false,
  "binary": {
    "macos": {
      "x86_64": "target/release/cockatiel_commend",
      "aarch64": "target/release/cockatiel_commend",
      "arm": "target/release/cockatiel_commend"
    },
    "linux": {
      "x86_64": "target/release/cockatiel_commend",
      "aarch64": "target/release/cockatiel_commend",
      "arm": "target/release/cockatiel_commend"
    },
    "windows": {
      "x86_64": "target/release/cockatiel_commend.exe",
      "aarch64": "target/release/cockatiel_commend.exe",
      "arm": "target/release/cockatiel_commend.exe"
    }
  },
  "price": 0,
  "min_rank": 0,
  "authority": 0,
  "build_command": "cargo",
  "build_flags": [
    "build",
    "--release"
  ],
  "credentials": [
    {
      "key": "command_flag",
      "label": "Command Flag",
      "list": false,
      "sensitive": false
    },
    {
      "key": "reconnect_base_secs",
      "label": "Reconnect base (s)",
      "list": false,
      "sensitive": false
    },
    {
      "key": "reconnect_max_secs",
      "label": "Reconnect max (s)",
      "list": false,
      "sensitive": false
    }
  ]
}
