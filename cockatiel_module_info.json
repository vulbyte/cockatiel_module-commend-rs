{
  "name": "commend",
  "description": "chat-command commend — any verified user may commend another user (unlimited); parses !commend <user> <reason>",
  "version": "0.1.0",
  "capabilities": "preprocess",
  "root_file": "./src/main.rs",
  "launch_command": "cargo run",
  "command_flags": ["--release"],
  "autostart": false,
  "terminal": false,
  "binary": {
    "macos": { "x86_64": "target/release/cockatiel_commend", "aarch64": "target/release/cockatiel_commend", "arm": "target/release/cockatiel_commend" },
    "linux": { "x86_64": "target/release/cockatiel_commend", "aarch64": "target/release/cockatiel_commend", "arm": "target/release/cockatiel_commend" },
    "windows": { "x86_64": "target/release/cockatiel_commend.exe", "aarch64": "target/release/cockatiel_commend.exe", "arm": "target/release/cockatiel_commend.exe" }
  }
}
